# Copy this file to .env.local and fill in values from your Supabase project.
# Settings > API in the Supabase dashboard.

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Public anon key (safe to expose to the browser; RLS protects the data).
# NOTE: never put the service_role key or any AI provider key here — those are
# server-only and live in Supabase (Vault) + Edge Functions. See spec §8.
VITE_SUPABASE_ANON_KEY=
